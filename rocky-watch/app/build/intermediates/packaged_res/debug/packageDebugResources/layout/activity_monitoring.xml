<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rocky_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:boxedEdges="all">

        <!-- Rocky mascot — switches to concerned when a trigger fires -->
        <ImageView
            android:id="@+id/rockyImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_rocky_happy"
            android:contentDescription="@string/app_name" />

        <!-- Status line — updates on each action -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/rec_recording"
            android:textColor="@color/rocky_slate_600"
            android:textSize="10sp" />

        <!-- Heart Rate trigger — rose pill -->
        <Button
            android:id="@+id/heartRateButton"
            android:layout_width="150dp"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_rose"
            android:stateListAnimator="@null"
            android:text="@string/rec_hr_button"
            android:textAllCaps="false"
            android:textColor="@color/rocky_rose_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Fall trigger — amber pill -->
        <Button
            android:id="@+id/fallButton"
            android:layout_width="150dp"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_button_amber_fill"
            android:stateListAnimator="@null"
            android:text="@string/rec_fall_button"
            android:textAllCaps="false"
            android:textColor="@color/rocky_amber_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Stop — outlined secondary, stops recording and POSTs audio -->
        <Button
            android:id="@+id/stopButton"
            android:layout_width="150dp"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_button_secondary"
            android:stateListAnimator="@null"
            android:text="@string/rec_stop_button"
            android:textAllCaps="false"
            android:textColor="@color/rocky_slate_600"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.wear.widget.BoxInsetLayout>
