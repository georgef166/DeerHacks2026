<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rocky_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:boxedEdges="all">

        <ImageView
            android:id="@+id/rockyImage"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_rocky_normal"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_name"
            android:textColor="@color/rocky_slate_800"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/status_idle"
            android:textColor="@color/rocky_slate_400"
            android:textSize="10sp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:text="@string/start_monitoring"
            android:textAllCaps="false"
            android:textColor="@color/rocky_emerald_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="88dp"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_button_secondary"
            android:stateListAnimator="@null"
            android:text="@string/settings"
            android:textAllCaps="false"
            android:textColor="@color/rocky_slate_600"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.wear.widget.BoxInsetLayout>
